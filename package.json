{
  "name": "regops-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "db:migrate": "pnpm --filter @regops-ai/database db:migrate",
    "db:seed": "pnpm --filter @regops-ai/database db:seed",
    "db:studio": "pnpm --filter @regops-ai/database db:studio",
    "db:reset": "pnpm --filter @regops-ai/database db:reset",
    "db:test:setup": "tsx scripts/setup-test-databases.ts",
    "db:test:migrate": "pnpm --filter @regops-ai/database db:test:migrate",
    "db:test:reset": "pnpm --filter @regops-ai/database db:test:reset",
    "test:setup": "pnpm db:test:setup"
  },
  "devDependencies": {
    "pg": "^8.20.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
