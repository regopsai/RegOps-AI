# Database
DATABASE_URL="postgresql://regops:regops_dev_password@localhost:5432/regops_ai?schema=public"

# Test Databases (isolated from development DB)
WEB_TEST_DATABASE_URL="postgresql://regops:regops_dev_password@localhost:5432/regops_ai_web_test?schema=public"
DATABASE_TEST_DATABASE_URL="postgresql://regops:regops_dev_password@localhost:5432/regops_ai_database_test?schema=public"

# Auth
AUTH_SECRET="change-me-in-production-min-32-characters-long"
AUTH_TRUST_HOST="true"

# Seed
REGOPS_SEED_PASSWORD="RegOpsDev123!"

# Application
APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# AI Provider
# Supported values: "openai-compatible", "mock"
# "mock" is for local development and tests only.
# Production MUST use "openai-compatible" with a real API key and model.
# Using mock in production requires explicit override (see REGOPS_ALLOW_MOCK_AI_IN_PRODUCTION below).
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_CONTEXT_CHARS="30000"

# DANGER: Only set to "true" if you explicitly intend to use mock AI output in production.
# Mock output is deterministic fake data and must never be used for real compliance work.
REGOPS_ALLOW_MOCK_AI_IN_PRODUCTION="false"

# Object Storage (S3-compatible)
STORAGE_DRIVER="local"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="regops-ai-uploads"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="false"

# Local storage path (default: .regops-storage in repo root)
LOCAL_STORAGE_ROOT=""

# Upload limits
MAX_DOCUMENT_UPLOAD_BYTES="10485760"
